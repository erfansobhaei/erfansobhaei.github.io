<nav class="site-nav" aria-label="Primary">
  {%- for item in navigation.items %}
  <a
    class="page-link{% if page.url == item.href %} page-link-current{% endif %}"
    href="{{ item.href }}"
    {%- if item.external %} target="_blank" rel="noopener"{% endif %}
    {%- if page.url == item.href %} aria-current="page"{% endif %}
    >{{ item.text }}</a
  >
  {%- endfor %} {% if site.cvUrl %}
  <a class="page-link" href="{{ site.cvUrl }}" target="_blank" rel="noopener"
    >CV</a
  >
  {% endif %} {% include "components/theme-toggle.njk" %}
</nav>

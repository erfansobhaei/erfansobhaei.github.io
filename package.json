{
  "name": "erfansobhaei.github.io",
  "version": "1.0.0",
  "description": "Personal academic website of Erfan Sobhaei.",
  "type": "module",
  "scripts": {
    "build": "eleventy",
    "serve": "eleventy --serve",
    "clean": "rm -rf _site",
    "debug": "DEBUG=* eleventy",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:check": "eslint . --max-warnings 0",
    "pre-commit": "pre-commit run --all-files",
    "prepare": "command -v pre-commit >/dev/null 2>&1 && pre-commit install || true"
  },
  "keywords": [],
  "author": "Erfan Sobhaei",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@eslint/css": "^0.10.0",
    "@eslint/js": "^9.32.0",
    "@eslint/json": "^0.13.1",
    "@eslint/markdown": "^7.1.0",
    "@html-eslint/eslint-plugin": "^0.44.0",
    "eslint": "^9.32.0",
    "js-yaml": "^4.1.0",
    "markdown-it": "^14.1.0"
  }
}
